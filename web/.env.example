# Copy to .env.local (git-ignored) to use. Vite inlines VITE_* values at build time.

# Base URL of the Go server. Leave unset in development: the Vite dev server
# proxies /api and /ws to the Go server, so the app is same-origin.
# Set it when the frontend is hosted apart from the server (e.g. Netlify + Fly):
# VITE_API_URL=https://your-app.fly.dev
